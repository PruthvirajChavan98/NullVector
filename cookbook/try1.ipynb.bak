 "cells": [
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "46ec7123",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "from pathlib import Path\n",
    "from nullvector.llm import (\n",
    "    GatewayConfig, \n",
    "    LiteLLMProviderConfig, \n",
    "    GatewayService, \n",
    "    StructuredOutputMode\n",
    ")\n",
    "from nullvector.domain import ParseRequest, ParserSettings, TreeBuildRequest, TreeSettings\n",
    "from nullvector.ingest import parse_document\n",
    "from nullvector.tree import build_tree\n",
    "from nullvector.tree.repair import NoopRepairEngine\n",
    "\n",
    "# 1. FIX THE LLM CONFIG: Set the environment variables, then pass their NAMES to the config\n",
    "os.environ[\"OPENROUTER_API_KEY\"] = \"REDACTED_OPENROUTER_KEY\" # Please rotate this!\n",
    "os.environ[\"OPENROUTER_API_BASE\"] = \"https://openrouter.ai/api/v1\"\n",
    "\n",
    "llm_provider_config = LiteLLMProviderConfig(\n",
    "    model=\"openrouter/google/gemini-3.1-flash-lite-preview\",\n",
    "    api_base_env_var=\"MOONSHOT_API_BASE\",  # Points to the env var\n",
    "    api_key_env_var=\"MOONSHOT_API_KEY\",    # Points to the env var\n",
    "    extra_body={\"temperature\": 1.0}\n",
    ")\n",
    "\n",
    "# 2. FIX THE MODE: LiteLLM uses Transport Compatible mode, not Provider Native\n",
    "gateway_config = GatewayConfig(\n",
    "    provider=llm_provider_config,\n",
    "    timeout_seconds=60.0,\n",
    "    structured_output_mode_preference=StructuredOutputMode.TRANSPORT_COMPATIBLE\n",
    ")\n",
    "\n",
    "gateway = GatewayService(config=gateway_config)"
   ]
  },
