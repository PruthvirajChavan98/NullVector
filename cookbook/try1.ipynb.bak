   "source": [
    "# 3. FIX THE PATHS & BUST THE CACHE\n",
    "absolute_artifact_root = str(Path.cwd() / \"artifacts\" / \"parse_runs\")\n",
    "settings = ParserSettings(\n",
    "    tessdata_path=\"/usr/share/tesseract-ocr/5/tessdata\",\n",
    "    ocr_dpi=300\n",
    ")\n",
    "\n",
    "parse_request = ParseRequest(\n",
    "    source_path=\"/home/pruthvi/projects/NullVector/903000608.pdf\", \n",
    "    parse_run_id=\"run_baseline_v2\",       # <--- CHANGED TO v2 TO BUST THE CACHE\n",
    "    artifact_root=absolute_artifact_root, \n",
    "    settings=settings\n",
    ")\n",
    "\n",
    "print(\"Starting Parser Substrate...\")\n",
    "parse_manifest = parse_document(parse_request)\n",
    "print(f\"Ingestion Complete! Document ID: {parse_manifest.document_id}\")\n",
    "\n",
    "\n",
    "# 4. EXECUTE THE TREE PIPELINE\n",
    "tree_settings = TreeSettings(\n",
    "    max_pages_per_leaf_node=10,\n",
    "    max_tokens_per_leaf_node=15000,\n",
    "    strategy_accuracy_threshold=0.85\n",
    ")\n",
    "\n",
    "tree_request = TreeBuildRequest(\n",
    "    parse_manifest_path=f\"{parse_manifest.artifact_root}/manifest.json\",\n",
    "    tree_run_id=\"semantic_tree_v2\", # <--- Updated to match v2\n",
    "    summarize=True,\n",
    "    settings=tree_settings\n",
    ")\n",
    "\n",
    "print(\"Starting Semantic Tree Assembly...\")\n",
    "tree_manifest = build_tree(\n",
    "    tree_request,\n",
    "    gateway=gateway,\n",
    "    repair_engine=NoopRepairEngine()\n",
    ")\n",
    "\n",
    "print(f\"Tree Build Complete!\")\n",
    "print(f\"Total Nodes: {tree_manifest.committed_node_count}\")\n",
    "print(f\"Coverage Gaps: {tree_manifest.unassigned_span_count}\")"
   ]
  },
