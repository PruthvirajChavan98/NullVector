   "source": [
    "from pathlib import Path\n",
    "from pydantic import TypeAdapter\n",
    "from nullvector.domain import NodeCard\n",
    "\n",
    "# 1. Read the raw JSON string (do NOT use json.loads)\n",
    "cards_path = Path(tree_manifest.node_cards_path)\n",
    "json_string = cards_path.read_text(encoding=\"utf-8\")\n",
    "\n",
    "# 2. Let Pydantic's TypeAdapter handle the JSON-to-Strict-Tuple/Enum coercion\n",
    "adapter = TypeAdapter(list[NodeCard])\n",
    "node_cards = adapter.validate_json(json_string)\n",
    "\n",
    "# 3. Print the results\n",
    "print(\"\\n--- Document Semantic Tree ---\")\n",
    "for card in node_cards[:10]:\n",
    "    path_str = \" > \".join(card.path)\n",
    "    span = f\"Pg {card.page_span.start_page}-{card.page_span.end_page}\"\n",
    "    print(f\"[{span}] {path_str}\")\n",
    "    \n",
    "    if card.summary:\n",
    "        print(f\"Summary [{card.summary_method.value}]: {card.summary}...\\n\")"
   ]
  },
