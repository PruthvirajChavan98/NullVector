   "source": [
    "import json\n",
    "from pathlib import Path\n",
    "from nullvector.domain import NodeCard\n",
    "\n",
    "# Load the generated Node Cards\n",
    "cards_path = Path(tree_manifest.node_cards_path)\n",
    "raw_cards = json.loads(cards_path.read_text(encoding=\"utf-8\"))\n",
    "\n",
    "# Validate them into Pydantic models\n",
    "node_cards = [NodeCard.model_validate(c) for c in raw_cards]\n",
    "\n",
    "# Print the first 10 nodes to see your hierarchy\n",
    "print(\"\\n--- Document Semantic Tree ---\")\n",
    "for card in node_cards[:10]:\n",
    "    path_str = \" > \".join(card.path)\n",
    "    span = f\"Pg {card.page_span.start_page}-{card.page_span.end_page}\"\n",
    "    print(f\"[{span}] {path_str}\")\n",
    "    # If you ran summarization, you can print card.summary here too!"
   ]
  },
