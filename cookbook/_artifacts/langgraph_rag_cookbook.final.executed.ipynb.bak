      "  \"visual_attachments_by_node\": {},\n",
      "  \"context_chunks\": [\n",
      "    {\n",
      "      \"node_id\": \"20b912e91b26b030e990db21ab91e02669544b4a2851208b13b4b7abb9aa8e47\",\n",
      "      \"title\": \"Overview\",\n",
      "      \"summary\": \"Overview\",\n",
      "      \"page_span\": {\n",
      "        \"start_page\": 0,\n",
      "        \"end_page\": 1\n",
      "      },\n",
      "      \"visual_summaries\": []\n",
