# NullVector — environment configuration template
#
# Copy this file to `.env` and fill in the values you need:
#   cp .env.example .env
#
# `.env` is gitignored and never committed.
# All variables below are optional unless noted as REQUIRED for a given workflow.

# =============================================================================
# PostgreSQL storage backend (used by cookbook notebooks)
# =============================================================================
# Full Postgres DSN. Default is a local-dev connection string — override for
# any non-local use.
NULLVECTOR_POSTGRES_CONNINFO=postgresql://REDACTED_DB_CRED@localhost:5432/app

# Target Postgres schema. NullVector auto-creates its tables under this schema.
NULLVECTOR_POSTGRES_SCHEMA=public

# =============================================================================
# LLM / VLM gateway — pick ONE provider path
# =============================================================================

# --- OpenRouter (cookbook 01 quickstart default) ---
# Required for live VLM transcription and LLM hierarchy synthesis in cookbook 01.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Groq (cookbook 02 LangGraph agent) ---
# Comma-separated list of Groq API keys for round-robin rotation.
# Required for cookbook 02 LangGraph agent.
# Get keys at https://console.groq.com/keys
# Example: GROQ_API_KEYS=gsk_abc...,gsk_def...,gsk_ghi...
GROQ_API_KEYS=

# --- Direct OpenAI (advanced, bypass LiteLLM) ---
# Only needed when using the OpenAI Responses adapter directly
# (not the LiteLLM adapter, which is the default path).
OPENAI_API_KEY=

# =============================================================================
# Model selection
# =============================================================================
# LiteLLM model identifier. Any model supported by LiteLLM works here.
# Examples:
#   openrouter/google/gemini-2.5-flash-lite-preview-09-2025
#   openrouter/anthropic/claude-sonnet-4.5
#   groq/meta-llama/llama-4-scout-17b-16e-instruct
NULLVECTOR_LLM_MODEL=openrouter/google/gemini-2.5-flash-lite-preview-09-2025

# =============================================================================
# Notebook runtime flags
# =============================================================================
# Set to "0" to disable VLM/LLM calls in the notebooks (falls back to
# deterministic outline-only mode). Default: "1".
NULLVECTOR_NOTEBOOK_ENABLE_BRAIN=1

# =============================================================================
# Observability (structured event logging)
# =============================================================================
# Path where NullVector writes JSONL structured events.
NULLVECTOR_OBSERVABILITY_JSONL_PATH=artifacts/runtime/observability.jsonl

# Set to "1" / "true" / "yes" / "on" to disable structured logging entirely.
# NULLVECTOR_OBSERVABILITY_DISABLE=

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
NULLVECTOR_OBSERVABILITY_LEVEL=INFO
